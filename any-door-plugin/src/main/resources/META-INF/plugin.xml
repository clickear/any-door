<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="true">
    <id>io.github.lgp547.any-door-plugin</id>
    <name>AnyDoor</name>
    <vendor email="lgp547279@163.com" url="https://github.com/lgp547">lgp</vendor>
    <idea-version since-build="243"/>
    <description><![CDATA[
        Any method to execute a Java project,Either the 'App' layer or the 'Dao' layer can execution directly.<br>
        Getting Started:<br>
        <ul>
            <li>fill 'Preferences.Other Settings.Setting Any Door' text box (command+,)</li>
            <li>select method and 'Open AnyDoor' (control/command+shift+D)</li>
            <li>fill json param before run</li>
        </ul>

        执行 Java 项目的任意方法，无论是 App 层还是 Dao 层方法都可以直接运行<br>
        快速开始：<br>
        <ul>
            <li>启动项目</li>
            <li>选择要执行的方法，右键选择 Open AnyDoor (control/command+shift+D)</li>
            <li>填充参数点击ok，即可调用到当前方法</li>
        </ul>
        详情说明见 <a href="https://github.com/lgp547/any-door#readme">any-door#readme</a><br>
        QQ讨论群: 421880294<br><br>
    ]]></description>

    <change-notes><![CDATA[
        <strong>2.7.1 上游改进整合</strong>
        <ul>
            <li>Agent 依赖包在构建时生成，改善 Run/Debug 启动卡顿</li>
            <li>调用回调使用不可变元数据快照，修复 PSI 读访问异常</li>
            <li>修复参数模板生成、静态字段过滤及调试表达式编辑器的数据访问</li>
        </ul>
        <strong>2.7.0 Spring Bean 精确选择</strong>
        <ul>
            <li>多个 Spring Bean 按名称、所属容器和代理类型选择调用实例</li>
            <li>支持抽象父类方法和子类重写方法的精确调用</li>
            <li>修复 Spring Boot 可执行 JAR、父子加载器和同名类隔离场景</li>
            <li>请求文件支持指定 Bean、容器和类加载器</li>
        </ul>
        <strong>2.3.0 参数库版本</strong>
        <ul>
            <li>[feat]参数库升级为类、方法、参数方案三级树形展示</li>
            <li>[feat]支持搜索、JSON 预览、重命名、批量删除和双击打开</li>
            <li>[feat]调用窗口支持另存为参数方案和保存修改</li>
        </ul>
        <strong>2.2.10 修复版本</strong>
        <ul>
            <li>[fix]修复 IDEA 2026.2 中生成全部参数示例时的 PSI 读访问异常</li>
        </ul>
        <strong>2.2.9 修复版本</strong>
        <ul>
            <li>[fix]修复 MANIFEST.MF 文件中替换符未正常替换的问题</li>
        </ul>
        <strong>2.2.8 修复版本</strong>
        <ul>
            <li>[fix]首次打开新参数面板时输入区域过小</li>
            <li>[fix]加载中禁用 RUN，避免内容未完成绑定时误提交</li>
        </ul>
        <strong>2.2.0 功能扩展版本</strong>
        <ul>
            <li>支持提前执行任意代码（方便设置上下文）</li>
            <li>支持 Json 带有注释的内容</li>
        </ul>
        <strong>2.1.4 常规支持版本</strong>
        <ul>
            <li>支持高版本代码，调整默认支持未来所有版本</li>
            <li>[fix]24.1版本报错问题</li>
        </ul>
        <strong>2.1.3 常规支持版本</strong>
        <ul>
            <li>支持IDEA的24.1版本</li>
            <li>返回值是Optional类型直接打印内容</li>
            <li>[fix]增加jsonKey判断逻辑</li>
        </ul>
        <strong>2.1.2 修复版本</strong>
        <ul>
            <li>支持23.3版本</li>
            <li>[fix]jsonKey的判断</li>
            <li>[fix]批量情况接口的参数传递</li>
        </ul>
    ]]>
    </change-notes>



    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- setting -->
        <projectConfigurable instance="io.github.lgp547.anydoorplugin.settings.AnyDoorSettingsConfigurable"
                             id="io.github.lgp547.anydoorplugin.settings.AnyDoorSettingsConfigurable"
                             displayName="Any Door" nonDefaultProject="true"/>
        <projectService serviceImplementation="io.github.lgp547.anydoorplugin.settings.AnyDoorSettingsState"/>
        <projectService serviceImplementation="io.github.lgp547.anydoorplugin.request.AnyDoorRequestGutterService"/>
        <postStartupActivity implementation="io.github.lgp547.anydoorplugin.request.AnyDoorRequestStartupActivity"/>

        <!-- Add your extensions here -->
        <!-- 配置 File -> Settings -> Tools -->
<!--        <projectConfigurable groupId="tools" displayName="AnyDoorPlugin ParamList Config" id="test.id"-->
<!--                             instance=""/>-->

        <!-- 窗体 (IDEA 界面右侧) -->
        <toolWindow id="Any-Door" secondary="false" anchor="right"
                    icon="io.github.lgp547.anydoorplugin.util.AnyDoorIcons.default_icon"
                    factoryClass="io.github.lgp547.anydoorplugin.action.ParamListMenuToolWindow"/>
        <fileType name="AnyDoor Request" implementationClass="io.github.lgp547.anydoorplugin.request.AnyDoorRequestFileType" fieldName="INSTANCE" extensions="anydoor" language="AnyDoor"/>
        <lang.parserDefinition language="AnyDoor" implementationClass="io.github.lgp547.anydoorplugin.request.AnyDoorParserDefinition"/>
        <lang.syntaxHighlighterFactory language="AnyDoor" implementationClass="io.github.lgp547.anydoorplugin.request.AnyDoorSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="io.github.lgp547.anydoorplugin.request.AnyDoorColorSettingsPage"/>
        <lang.foldingBuilder language="AnyDoor" implementationClass="io.github.lgp547.anydoorplugin.request.AnyDoorFoldingBuilder"/>
        <lang.structureViewBuilderFactory language="AnyDoor" implementationClass="io.github.lgp547.anydoorplugin.request.AnyDoorStructureViewFactory"/>
        <completion.contributor implementationClass="io.github.lgp547.anydoorplugin.request.AnyDoorCompletionContributor" language="AnyDoor"/>
        <completion.contributor implementationClass="io.github.lgp547.anydoorplugin.request.AnyDoorJsonCompletionContributor" language="JSON"/>
        <typedHandler implementation="io.github.lgp547.anydoorplugin.request.AnyDoorTypedHandler"/>
        <annotator language="AnyDoor" implementationClass="io.github.lgp547.anydoorplugin.request.AnyDoorAnnotator"/>
        <psi.referenceContributor language="AnyDoor" implementation="io.github.lgp547.anydoorplugin.request.AnyDoorRunReferenceContributor"/>
        <gotoDeclarationHandler implementation="io.github.lgp547.anydoorplugin.request.AnyDoorGotoDeclarationHandler"/>
        <lang.directNavigationProvider implementation="io.github.lgp547.anydoorplugin.request.AnyDoorRunNavigationProvider"/>
        <languageInjector implementation="io.github.lgp547.anydoorplugin.request.AnyDoorJsonInjector"/>
        <intentionAction>
            <className>io.github.lgp547.anydoorplugin.request.FormatAnyDoorJsonIntention</className>
            <category>AnyDoor</category>
        </intentionAction>

        <!-- notice -->
        <applicationService serviceImplementation="io.github.lgp547.anydoorplugin.util.NotifierUtil"/>
        <notificationGroup id="AnyDoor" displayType="BALLOON"/>

<!--        <languageInjectionContributor implementationClass="io.github.lgp547.anydoorplugin.dialog.completion.JsonInjectorContributor" language="JSON"/>-->

<!--        <languageInjectionPerformer implementationClass="io.github.lgp547.anydoorplugin.dialog.completion.JsonInjectionPerformer" language="JSON"/>-->

        <!--suppress PluginXmlValidity -->
        <lang.directNavigationProvider implementation="io.github.lgp547.anydoorplugin.dialog.navigation.JsonKeyNavigationProvider" />

        <completion.contributor implementationClass="io.github.lgp547.anydoorplugin.dialog.completion.JsonKeyCompletionContributor" language="JSON"/>
    </extensions>

    <actions>
        <action id="AnyDoorPlugin.FormatRequestJsonAction" class="io.github.lgp547.anydoorplugin.request.FormatAnyDoorJsonAction" text="Format AnyDoor JSON Body" description="Format the JSON body of the request at the caret">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="AnyDoorPlugin.GenerateRequestAction"
                class="io.github.lgp547.anydoorplugin.request.GenerateAnyDoorRequestAction"
                text="Generate .anydoor Request"
                description="Create an editable AnyDoor request from this method">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="AnyDoorPlugin.RunRequestAction"
                class="io.github.lgp547.anydoorplugin.request.RunAnyDoorRequestAction"
                text="Run AnyDoor Request"
                description="Run the request at the current .anydoor file"
                icon="io.github.lgp547.anydoorplugin.util.AnyDoorIcons.default_icon">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="AnyDoorPlugin.AnyDoorOpenAction"
                class="io.github.lgp547.anydoorplugin.action.AnyDoorOpenAction"
                text="Open AnyDoor"
                description="The method will be called"
                icon="io.github.lgp547.anydoorplugin.util.AnyDoorIcons.default_icon">
            <keyboard-shortcut keymap="$default" first-keystroke="control shift D"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="AnyDoorPlugin.AnyDoorAgainOpenAction"
                class="io.github.lgp547.anydoorplugin.action.AnyDoorAgainOpenAction"
                text="Again Open AnyDoor"
                description="The last method will be called"
                icon="io.github.lgp547.anydoorplugin.util.AnyDoorIcons.default_icon">
            <keyboard-shortcut keymap="$default" first-keystroke="alt control shift S"/>
            <add-to-group group-id="EditorPopupMenu"/>
        </action>
    </actions>

    <applicationListeners>
        <listener topic="com.intellij.execution.ExecutionListener"
                  class="io.github.lgp547.anydoorplugin.listener.ExecutionListenerImpl"/>
    </applicationListeners>

</idea-plugin>
